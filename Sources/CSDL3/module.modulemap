// SDL3 vu par Swift.
//
// Un `systemLibrary` plutôt qu'une vendorisation : SDL3 est distribué compilé
// pour Windows, et le recompiler n'apporterait rien qu'une heure de build. Les
// chemins d'en-têtes et de bibliothèque sont passés au moment de la compilation
// — voir `Tools/sdl3.ps1`, qui les fabrique — plutôt que figés ici, où ils
// dépendraient de l'endroit où l'archive a été déballée.
module CSDL3 [system] {
    header "shim.h"
    link "SDL3"
    export *
}
