// miniaudio vu par Swift.
//
// L'en-tête n'est pas versionné — il pèse plus d'un mégaoctet et se retélécharge
// en une seconde. `Tools/miniaudio.ps1` (et `.sh`) le déposent dans `include/`.
// Son absence fait échouer la compilation sur un message clair plutôt que sur une
// erreur de lien incompréhensible.
module CMiniaudio {
    header "shim.h"
    export *
}
