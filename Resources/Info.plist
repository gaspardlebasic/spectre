<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Spectre</string>
	<key>CFBundleDisplayName</key>
	<string>Spectre</string>
	<key>CFBundleExecutable</key>
	<string>Spectre</string>
	<key>CFBundleIconFile</key>
	<string>Spectre</string>
	<key>CFBundleIdentifier</key>
	<string>local.spectre</string>
	<!-- Les cinq langues, déclarées pour macOS lui-même. Ce sont elles qui font
	     que les menus fournis par AppKit — « À propos de Spectre », « Masquer »,
	     « Quitter », « Édition », « Fenêtre » — suivent la langue du Mac. Sans
	     cette déclaration et sans les dossiers .lproj que build.sh pose à côté,
	     le système tient l'application pour monolingue et sort ces entrées-là
	     en anglais, quelle que soit la langue choisie. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
		<string>es</string>
		<string>de</string>
		<string>pl</string>
	</array>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Fichier audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
